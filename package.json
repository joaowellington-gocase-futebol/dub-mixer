{
  "name": "dub-mixer",
  "productName": "DUB-MIXER",
  "version": "1.0.0",
  "description": "DUB-MIXER - Professional dub / reggae / sound system mixing studio",
  "author": "DUB-MIXER",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "vite build && electron .",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "android:sync": "vite build && npx cap sync android",
    "android:apk": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:all": "./scripts/build-all.sh"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.dubmixer.studio",
    "productName": "DUB-MIXER",
    "copyright": "DUB-MIXER",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "DUB-MIXER"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DUB-MIXER",
      "artifactName": "DUB-MIXER-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DUB-MIXER-Portable-${version}.${ext}"
    }
  }
}